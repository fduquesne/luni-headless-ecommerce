{
  "workspace": ["./apps/api", "./libs/contracts"],
  "unstable": ["kv"],
  "fmt": { "lineWidth": 100 },
  "lint": { "rules": { "tags": ["recommended"] } },
  "tasks": {
    "dev": "deno task --cwd apps/api dev",
    "check": "deno fmt --check && deno lint && deno check && deno test --permit-no-files"
  },
  "imports": {
    "zod": "npm:zod@^4.6.7"
  }
}
